---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Home"
  description="Educational information to help you understand and compare U.S. car and home insurance."
>
  <section class="hero">
    <h1>Understand your insurance before you compare prices.</h1>
    <p class="lead">
      Plain-language information about car and home insurance — coverage,
      pricing factors, and state rules — checked against primary sources
      before it's published here.
    </p>
  </section>

  <section class="value-grid" aria-label="What this site is">
    <div class="value-card">
      <h2>Educational, not a quote</h2>
      <p>
        Nothing here is an insurance quote, an offer, or advice. It's
        information meant to help you ask better questions.
      </p>
    </div>
    <div class="value-card">
      <h2>Only verified facts</h2>
      <p>
        A rule appears here only after it's traced to a primary source — a
        regulator, government body, or an insurer's own published terms —
        with a source link and a last-verified date.
      </p>
    </div>
    <div class="value-card">
      <h2>No personal data, for now</h2>
      <p>
        This site does not collect leads, accounts, or uploads. Nothing you
        type into a tool here is saved or sent anywhere.
      </p>
    </div>
  </section>

  <section aria-label="Explore the site">
    <h2>Explore</h2>
    <div class="section-links">
      <a href="/auto-insurance/">Auto Insurance</a>
      <a href="/home-insurance/">Home Insurance</a>
      <a href="/compare/">Compare</a>
      <a href="/savings/">Savings</a>
      <a href="/learn/">Learn</a>
      <a href="/insurance-companies/">Insurance Companies</a>
      <a href="/tools/">Tools</a>
      <a href="/about/">About</a>
    </div>
  </section>
</BaseLayout>
