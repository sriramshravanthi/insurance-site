---
interface Props {
  fact: string;
  value?: string | null;
  legalCitation?: string | null;
  sourceName: string;
  sourceUrl: string;
  lastVerified: string;
}

const { fact, value, legalCitation, sourceName, sourceUrl, lastVerified } =
  Astro.props;
---

<article class="fact-card">
  <h3>{fact}</h3>
  {value && <p class="fact-value">{value}</p>}
  {legalCitation && <p class="fact-citation">{legalCitation}</p>}
  <p class="fact-meta">
    Source:
    <a href={sourceUrl} target="_blank" rel="noopener noreferrer"
      >{sourceName}</a
    >
    · Last verified {lastVerified}
  </p>
</article>
